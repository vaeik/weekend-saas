# Copy to secrets.yaml (GITIGNORED — never commit it) and fill in.
#
#   aio api-mesh create mesh.json --secrets secrets.yaml
#   aio api-mesh update mesh.json --secrets secrets.yaml
#
# MM_ACTION_URL is printed by `aio app deploy` under "web actions".
# MM_SECRET must match STOREFRONT_SHARED_SECRET in the app's .env exactly.
# Generate one with:  openssl rand -hex 32

MM_ACTION_URL: https://<NAMESPACE>.adobeioruntime.net/api/v1/web/menu-manager/storefront-menu-get
MM_SECRET: <the same value as STOREFRONT_SHARED_SECRET in ../.env>
