{
  "name": "weekend-menu-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Scandi Menu Manager rebuilt as an Adobe App Builder out-of-process app for Adobe Commerce as a Cloud Service (EVO-217)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "deploy:stage": "aio app deploy --no-publish",
    "deploy:prod": "aio app deploy",
    "test:storefront": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.storefront.config.mjs",
    "test:all": "npm test && npm run test:storefront",
    "smoke": "node scripts/smoke.js",
    "seed": "node scripts/seed-from-catalog.js",
    "seed:weekend": "node scripts/seed-weekend-menu.js",
    "menu": "node scripts/menu.js",
    "admin": "node scripts/admin-server.js",
    "typecheck:web-src": "tsc --noEmit -p src/commerce-backend-ui-2/web-src/tsconfig.json",
    "typecheck": "npm run typecheck:web-src",
    "seed:products": "python3 scripts/seed-accs-products.py",
    "seed:variants": "python3 scripts/seed-accs-variants.py",
    "menu:rebuild": "node scripts/rebuild-menu-from-catalog.js"
  },
  "dependencies": {
    "@adobe/aio-commerce-lib-app": "^1.10.1",
    "@adobe/aio-lib-core-logging": "^3.0.2",
    "@adobe/aio-lib-db": "^1.0.3",
    "@adobe/aio-lib-ims": "^8.1.2",
    "@adobe/aio-lib-state": "^5.3.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@adobe/aio-commerce-lib-admin-ui": "^1.0.1",
    "@react-spectrum/s2": "^1.6.0",
    "@tsconfig/bases": "^1.0.26",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#app.commerce.config": "./src/commerce-extensibility-1/.generated/app.commerce.config.js",
    "#web/*": "./src/commerce-backend-ui-2/web-src/src/*"
  },
  "@parcel/bundler-default": {
    "manualSharedBundles": [
      {
        "assets": [
          "**/@react-spectrum/s2/**",
          "src/commerce-backend-ui-2/web-src/*.{js,jsx,ts,tsx}"
        ],
        "name": "s2-styles",
        "types": [
          "css"
        ]
      }
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
