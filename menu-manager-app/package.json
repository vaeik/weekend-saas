{
  "name": "weekend-menu-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Scandi Menu Manager rebuilt as an Adobe App Builder out-of-process app for Adobe Commerce as a Cloud Service (EVO-217)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "deploy:stage": "aio app deploy --no-publish",
    "deploy:prod": "aio app deploy",
    "test:storefront": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.storefront.config.mjs",
    "test:all": "npm test && npm run test:storefront",
    "smoke": "node scripts/smoke.js",
    "seed": "node scripts/seed-from-catalog.js",
    "seed:weekend": "node scripts/seed-weekend-menu.js",
    "seed:weekend-demo": "node scripts/seed-weekend-demo.js",
    "menu": "node scripts/menu.js"
  },
  "dependencies": {
    "@adobe/aio-lib-core-logging": "^3.0.2",
    "@adobe/aio-lib-db": "^1.0.3",
    "@adobe/aio-lib-ims": "^8.1.2",
    "@adobe/aio-lib-state": "^5.3.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
