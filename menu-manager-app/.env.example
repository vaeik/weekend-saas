# Adobe I/O — populated by `aio app use` / Developer Console. NEVER commit .env
AIO_RUNTIME_AUTH=
AIO_RUNTIME_NAMESPACE=
AIO_RUNTIME_APIHOST=https://adobeioruntime.net

# Data layer. 'db' (default, plan §2) or 'state'. The repository interface
# makes this a one-line switch — see repository/index.js
AIO_DB_REGION=emea
MENU_REPOSITORY=db
MENU_CACHE_TTL_SECONDS=86400

# Shared secret the API Mesh must send as x-mm-secret on storefront-menu-get
STOREFRONT_SHARED_SECRET=

# Commerce (ACCS) — for the category / CMS page pickers
COMMERCE_BASE_URL=
COMMERCE_STORE_VIEW_CODE=default
